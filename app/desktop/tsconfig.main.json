 {
   "extends": "./tsconfig.json",
   "compilerOptions": {
     "outDir": "./dist",
     "module": "NodeNext",
     "moduleResolution": "NodeNext",
     "target": "ES2022",
     "lib": ["ES2022"],
     "types": ["node"],
     "composite": true,
     "esModuleInterop": true
   },
   "include": [
     "src/main.ts",
     "src/ipc/**/*.ts"
   ],
   "exclude": [
     "node_modules",
     "dist"
   ]
 }